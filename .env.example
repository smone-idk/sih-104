# Copy to .env and edit. All keys are optional — defaults are sane.

# cuda | cpu   (default: cuda if a GPU is visible, else cpu)
VOICESHIELD_DEVICE=cuda

# If true, model loaders never touch the network. Keep true at the demo venue.
VOICESHIELD_OFFLINE=true

# Privacy (§12) — genuinely enforced in ingest/pipeline.
VOICESHIELD_RETAIN_AUDIO=false

VOICESHIELD_HOST=127.0.0.1
VOICESHIELD_PORT=8000
